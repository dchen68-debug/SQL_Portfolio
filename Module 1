        total_incurred,
        total_paid_losses,
        incurred_loss_ratio,
        lr.claim_id,
        p.line_of_business,
        lr.policy_id         
    FROM policies p
    JOIN loss_ratios lr
    ON p.policy_id = lr.policy_id
)
SELECT * FROM final_cte fc
GROUP BY fc.line_of_business, fc.total_earned_prem, fc.total_incurred, fc.total_paid_losses, fc.incurred_loss_ratio, fc.claim_id, fc.policy_id



